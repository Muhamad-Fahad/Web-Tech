<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Muhammad Fahad Saeed - CV</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <!-- Include Navbar -->
    <%- include('partials/navbar') %>
    
    <!-- Flash Messages -->
    <% if (success && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    
    <% if (error && error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    
    <%- body %>

    <hr>

    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h3>About Us</h3>
                <p>Your trusted source for quality products.</p>
            </div>
            <div class="footer-section">
                <h3>Quick Links</h3>
                <ul>
                    <li><a href="#palace">PALACE MAHARISHI</a></li>
                    <li><a href="#clothing">CLOTHING</a></li>
                    <li><a href="#accessories">ACCESSORIES</a></li>
                    <li><a href="#footwear">FOOTWEAR</a></li>
                    <li><a href="#capsules">CAPSULES</a></li>
                    <li><a href="#fabric">FABRIC</a></li>
                    <li><a href="#journal">JOURNAL</a></li>
                    <li><a href="#about">ABOUT</a></li>
                    <li><a href="#early-access" class="early-access">EARLY ACCESS</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3>Contact Us</h3>
                <p>Email: info@Maharishi.com</p>
                <p>Phone: (123) 456-7890</p>
            </div>
        </div>
        <div class="page-navigation">
            <ul class="page-numbers">
                <li><a href="/" class="active">1</a></li>
                <li><a href="/assignment_2">2</a></li>
                <li><a href="/labtask_1">3</a></li>
                <li><a href="/labtask_2">4</a></li>
            </ul>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2024 MAHARISHI. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <% if (typeof script === 'undefined') { var script = ''; } %>
    <%- script %>
</body>
</html>