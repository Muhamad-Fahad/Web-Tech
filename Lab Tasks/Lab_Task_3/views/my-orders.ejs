<%- include('partials/header') %>

<div class="container mt-4">
    <h2>My Orders</h2>
    
    <% if (orders && orders.length > 0) { %>
        <% orders.forEach(order => { %>
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">Order #<%= order._id.toString().slice(-6) %></h5>
                        <small class="text-muted">Placed on <%= order.createdAt.toLocaleDateString() %></small>
                    </div>
                    <span class="badge bg-<%= order.status === 'completed' ? 'success' : order.status === 'cancelled' ? 'danger' : 'warning' %>">
                        <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                    </span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h6>Items:</h6>
                            <ul class="list-group list-group-flush">
                                <% order.items.forEach(item => { %>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <%= item.title %>
                                            <small class="text-muted">x<%= item.quantity %></small>
                                        </div>
                                        <span>$<%= (item.price * item.quantity).toFixed(2) %></span>
                                    </li>
                                <% }); %>
                            </ul>
                        </div>
                        <div class="col-md-4">
                            <h6>Shipping Details:</h6>
                            <p class="mb-1"><strong>Name:</strong> <%= order.user.name %></p>
                            <p class="mb-1"><strong>Phone:</strong> <%= order.user.phone %></p>
                            <p class="mb-1"><strong>Address:</strong> <%= order.user.address %></p>
                            <hr>
                            <h6>Total: $<%= order.totalPrice.toFixed(2) %></h6>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="alert alert-info">
            You haven't placed any orders yet. <a href="/">Start shopping</a>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %> 